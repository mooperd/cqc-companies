# Copy this file to .env and fill in real values for your local environment.
# .env is gitignored — never commit secrets. For real secrets prefer a
# .env.local (also gitignored); where both exist, .env.local overrides .env.

# --- Database ---
# Local dev default matches the docker-compose / k8s seed creds.
DATABASE_URL=postgresql://darwinist:darwinist@localhost:5432/darwinist

# --- Flask ---
# FLASK_ENV gates SECRET_KEY handling: with FLASK_ENV=production the app
# refuses to start unless SECRET_KEY is set. In development (the default) an
# unset SECRET_KEY is replaced by an ephemeral key with a warning at startup.
# Generate a stable local key with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
FLASK_ENV=development
SECRET_KEY=

# --- CQC syndication API (contingency path) ---
# We currently ingest via the bulk monthly downloads at cqc.org.uk; the API
# is kept as fallback. Auth flow is documented in CQC's developer portal at
# https://api-portal.service.cqc.org.uk/ — register there to obtain keys.
CQC_PRIMARY_KEY=replace-with-your-primary-key
CQC_SECONDARY_KEY=replace-with-your-secondary-key

# --- Companies House API (director enrichment) ---
# Free keys (no meaningful rate limit) from
# https://developer.company-information.service.gov.uk/. A key is tied to ONE
# environment, so register two applications (one Live, one Test) and keep both
# keys here. COMPANIES_HOUSE_ENV picks which key + base URL is used; the base is
# derived from the env, so they can never mismatch. Sandbox (test) companies are
# synthetic — real company numbers return no data there; use Test to exercise
# the client, Live for real directors. Put real keys in .env.local, not here.
# Used by `python -m companies_house officers <number>` and the WS2 enrichment
# (see docs/adr/0013-companies-house-source.md).
COMPANIES_HOUSE_ENV=live  # live | test
COMPANIES_HOUSE_LIVE_KEY=replace-with-your-live-key
COMPANIES_HOUSE_TEST_KEY=replace-with-your-test-key
# Optional single-key fallback, used for whichever env is selected if the
# env-specific key above isn't set:
# COMPANIES_HOUSE_API_KEY=replace-with-your-key

# --- Per-user secret encryption (ADR 0016) ---
# Fernet key that encrypts the per-user Phantombuster API key at rest on the User
# row. Required before storing or reading any User secret — secrets_box is
# fail-closed without it. Generate one:
#   python -m secrets_box keygen
# Keep the real value in .env.local, and DO NOT rotate it without re-encrypting
# existing secrets (a new key can't decrypt old ciphertext).
APP_SECRETS_KEY=

# --- Phantombuster (LinkedIn identification, ADR 0016) ---
# Account-level API key from https://phantombuster.com/ (Org Settings → API key).
# This is the FALLBACK used by `python -m phantombuster ...` and any run without
# a per-user key. The real model is per-user: each User's own Phantombuster key
# lives ENCRYPTED on their User row (not here). The LinkedIn *session* is NOT ours
# to hold — Phantombuster manages it (its browser extension connects the account
# and writes the phantom's sessionCookie), so there is no LINKEDIN_SESSION_COOKIE
# here (ADR 0016 amendment 2026-07-05). Put the real key in .env.local. Live
# scraping is gated on the GDPR posture (ADR 0017) — see docs/plans/linkedin-ingestion.md.
PHANTOMBUSTER_API_KEY=replace-with-your-phantombuster-key

# The saved LinkedIn Search Export agent that scrapes a company's people (PWS3).
# Create it once in the Phantombuster UI, connect a LinkedIn account, and put its
# agent id here — our driver launches it with {"search": <people-search URL>}.
PB_SEARCH_EXPORT_AGENT=
# The resolver (PWS2) borrows a LinkedIn sessionCookie from the identity connected
# on THIS agent. A connected Search Export agent already has one, so it can double
# as the source (set both to the same id). If unset, the lib falls back to its own
# default agent id (won't exist in your account). Run `python pb_doctor.py` to
# check the whole chain is wired before a live run.
PB_SOURCE_AGENT=

# --- phantombuster-lib resolver (LinkedIn company-id resolution, ADR 0016 PWS2/3) ---
# The company-id resolver + Search Export consumer depend on phantombuster-lib.
# The resolver reads CQC_PRIMARY_KEY (falling back to CQC_SECONDARY_KEY — declared
# above) for phantombuster-lib's CQC Syndication client, which supplies the
# brandName/brandId/website used to search + verify the LinkedIn match. The LinkedIn
# resolver itself is no-auth (public company page). Live resolution is gated on the
# GDPR posture (ADR 0017) — see docs/plans/linkedin-ingestion.md.
