.venv
__pycache__/
.vscode/
client_secret*

# Secrets — committed historically as a placeholder; now untracked.
# Copy .env.example to .env and fill in real values locally. Local override
# files (.env.local, .env.production.local, …) hold real keys — never commit.
# .env.example is the only tracked env file (it matches none of these).
.env
.env.local
.env.*.local

# Tooling caches
.claude/
.tldr/
.tldrignore
